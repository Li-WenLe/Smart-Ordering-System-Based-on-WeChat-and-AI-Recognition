/* 基础样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f7f7f7;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}
.empty image {
  width: 200rpx;
  margin-bottom: 20rpx;
}
.empty text {
  color: #999;
}

/* 优惠券卡片 */
.voucher-card {
  position: relative;
  height: 220rpx;
  margin-bottom: 30rpx;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

/* 未过期样式 */
.voucher-left {
  width: 30%;
  background: linear-gradient(135deg, #ff5f6d, #ff9966);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
  z-index: 2;
}
.amount {
  font-size: 48rpx;
  font-weight: bold;
}
.type {
  font-size: 24rpx;
  margin-top: 10rpx;
}

.voucher-right {
  width: 70%;
  padding: 20rpx;
  background-color: white;
  position: relative;
  z-index: 2;
}
.info-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}
.name {
  font-size: 28rpx;
  font-weight: bold;
}
.count {
  color: #ff5f6d;
  font-weight: bold;
}
.rules {
  font-size: 24rpx;
  color: #666;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 15rpx;
}
.expiry {
  font-size: 22rpx;
  color: #ff5f6d;
}
.use-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  background: #ff5f6d;
  color: white;
  border-radius: 30rpx;
  padding: 0 20rpx;
  height: 50rpx;
  line-height: 50rpx;
}

/* 已过期样式 */
.voucher-card.expired .voucher-left {
  background: linear-gradient(135deg, #ccc, #999);
}
.voucher-card.expired .name,
.voucher-card.expired .rules,
.voucher-card.expired .expiry {
  color: #999;
}
.voucher-card.expired .count {
  color: #999;
}
.voucher-card.expired .use-btn {
  background: #ccc;
}

/* 背景图 */
.bg-image {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0.1;
  z-index: 1;
}