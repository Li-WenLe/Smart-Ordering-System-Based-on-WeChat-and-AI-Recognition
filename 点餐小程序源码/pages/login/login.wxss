form {
  width: 80%;
  max-width: 600rpx; /* 限制表单最大宽度 */
  background-color: rgba(255, 255, 255, 0.9);
  padding: 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.content {
  width: 100%;
  margin-bottom: 30rpx; /* 增加间距 */
  padding: 20rpx; /* 增加内边距 */
  border: 1rpx solid #e0e0e0; /* 更柔和的边框颜色 */
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333; /* 输入文字颜色 */
  background-color: #f9f9f9; /* 输入框背景色 */
}

.content::placeholder {
  color: #999; /* 占位符文字颜色 */
}
.container {
  width: 100%;
  height: 100vh;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative; /* 为遮罩层定位 */
}

.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.4); /* 半透明黑色遮罩 */
  z-index: 1;
}

form {
  position: relative; /* 确保表单在遮罩层上方 */
  z-index: 2;
  width: 80%;
  background-color: rgba(255, 255, 255, 0.9); /* 表单背景更亮 */
  padding: 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2); /* 阴影更明显 */
}
