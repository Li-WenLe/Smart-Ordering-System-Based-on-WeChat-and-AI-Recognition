.wehx-foot-btn {
  width: 100%;
  padding: 20rpx;
  background: linear-gradient(90deg, #007AFF, #00BFFF); /* 渐变色背景 */
  color: white;
  border: none;
  border-radius: 10rpx;
  font-size: 32rpx;
  margin-top: 30rpx;
  transition: all 0.3s ease; /* 添加过渡效果 */
}

.wehx-foot-btn:hover {
  background: linear-gradient(90deg, #00BFFF, #007AFF); /* 悬停时反转渐变色 */
  transform: translateY(-2rpx); /* 轻微上移效果 */
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2); /* 悬停时阴影 */
}

button {
  width: 100%;
  padding: 20rpx;
  background-color: transparent;
  color: #007AFF;
  border: 1rpx solid #007AFF;
  border-radius: 10rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
  transition: all 0.3s ease;
}

button:hover {
  background-color: #007AFF;
  color: white;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
}