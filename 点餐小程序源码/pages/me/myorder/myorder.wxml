<view style="display: flex; flex-direction: row; justify-content: space-between; height: 100vh;">
  <!-- 菜单栏 -->
  <view class="menu-warp" style="width: 180rpx; background-color: #f5f5f5;">
    <scroll-view scroll-y style="height: 100%;">
      <view 
        class="menu-item {{activeTab === 'unpaid' ? 'active' : ''}}" 
        bindtap="switchTab" 
        data-type="unpaid"
      >
        待确认（演示）
      </view>
      <view 
        class="menu-item {{activeTab === 'completed' ? 'active' : ''}}" 
        bindtap="switchTab" 
        data-type="completed"
      >
        已完成
      </view>
      <view 
        class="menu-item {{activeTab === 'waiting' ? 'active' : ''}}" 
        bindtap="switchTab" 
        data-type="waiting"
      >
        待接单
      </view>
      <view 
        class="menu-item {{activeTab === 'delivering' ? 'active' : ''}}" 
        bindtap="switchTab" 
        data-type="delivering"
      >
        待送达
      </view>
      <view 
        class="menu-item {{activeTab === 'timeout' ? 'active' : ''}}" 
        bindtap="switchTab" 
        data-type="timeout"
      >
        已取消
      </view>
    </scroll-view>
  </view>

  <!-- 订单展示区域 -->
  <view class="order-container" style="flex: 1; padding: 20rpx;">
    <scroll-view scroll-y style="height: 100%;">
      <block wx:if="{{onshowList.length > 0}}">
        <block wx:for="{{onshowList}}" wx:key="orderId">
          <view class="order-item">
            <view class="order-header">
              <text class="order-id">订单号: {{item.orderId}}</text>
              <text class="order-status" style="color: {{getStatusColor(item.status)}}">
                {{getStatusText(item.status)}}
              </text>
            </view>
            
            <!-- 商品列表 -->
            <view class="order-products">
              <block wx:for="{{item.items}}" wx:key="dishId">
                <view class="product-item">
                  <image src="{{item.image}}" class="product-image"></image>
                  <view class="product-info">
                    <text class="product-name">{{item.dishname}}</text>
                    <view class="product-meta">
                      <text class="product-price">￥{{item.acount}}</text>
                      <text class="product-quantity">x{{item.number}}</text>
                    </view>
                  </view>
                </view>
              </block>
            </view>
            
            <view class="order-footer">
              <text class="order-total">共{{item.items.length}}件商品 合计: ￥{{item.totalPrice}}</text>
              <button class="reorder-btn" bindtap="reorder" data-id="{{item.orderId}}">再来一单</button>
            </view>
          </view>
        </block>
      </block>
      <block wx:else>
        <view class="empty-tip">
          <text>暂无{{activeTab === 'unpaid' ? '待确认（演示）' : activeTab === 'completed' ? '已完成' : activeTab === 'waiting' ? '待接单' : activeTab === 'delivering' ? '待送达' : '已取消'}}订单</text>
        </view>
      </block>
    </scroll-view>
  </view>
</view>