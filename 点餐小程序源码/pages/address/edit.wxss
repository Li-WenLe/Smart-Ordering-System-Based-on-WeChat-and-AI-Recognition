/* 基础样式 */
.container {
  background-color: #f5f5f5;
  min-height:100vh;
  padding:20rpx 30rpx; /* 增加左右边距 */
}

/* 分割线 */
.divider {
  height: 2rpx;
  background-color: #eee;
  margin: 20rpx 0;
}

/* 区域样式 */
.section {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  width: 100%;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
}

/* 输入框样式 */
.input {
  height: 80rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}

/* 性别选择 */
.gender-options {
  display: flex;
  margin-top: 20rpx;
}

.gender-option {
  padding: 10rpx 30rpx;
  border: 1rpx solid #ccc;
  border-radius: 30rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.gender-option.active {
  background-color: #FF6146;
  color: #fff;
  border-color: #FF6146;
}

/* 地址选择器 */
.address-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}

.placeholder {
  color: #999;
}

.arrow-icon {
  width: 30rpx;
  height: 30rpx;
}

/* 标签选择 */
.tag-options {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag-option {
  padding: 10rpx 30rpx;
  border: 1rpx solid #ccc;
  border-radius: 30rpx;
  margin-right: 20rpx;
  margin-bottom: 15rpx;
  font-size: 28rpx;
}

.tag-option.active {
  background-color: #FF6146;
  color: #fff;
  border-color: #FF6146;
}

/* 按钮区域 */
.button-area {
  display: flex;
  flex-direction: row;
  justify-content: space-between; /* 左右对齐并在中间创建间隔 */
  margin-top: 40rpx;
  width: 100%; /* 确保容器宽度足够 */
}

.save-btn {
  background-color: #FF6146;
  color: #fff;
  border-radius: 50rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 34rpx;
  margin-bottom: 20rpx;
  width: 45%; /* 设置按钮宽度 */
}

.cancel-btn {
  background-color: #fff;
  color: #666;
  border-radius: 50rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 34rpx;
  border: 1rpx solid #ddd;
  width: 45%; /* 设置按钮宽度 */
}