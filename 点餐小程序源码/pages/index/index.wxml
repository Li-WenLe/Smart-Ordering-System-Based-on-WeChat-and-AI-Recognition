<view class="search-box"bindtap="tosearchDetail">
  <input type="text" placeholder="请输入商品关键词"class="input-cell"/>
  <image src="/images/搜索.png"class="search-image"></image>
</view>
<view  class="swiper-type">
  <swiper indicator-dots='true' indicator-color="#fff" autoplay="true">
    <block wx:for="{{ bannerList}}">
    <swiper-item>
      <image class="swiper-image" bindtap="toBannerDetail" data-id="{{item.id}}" src="{{item.cover}}"></image>
    </swiper-item>
    </block>
  </swiper>
</view>
<view class="image">
  <block wx:for="{{onBannerShowList}}">
    <view class="image-container" bindtap="toTypeDetail" data-type="{{item.type}}">
      <image src="{{item.cover}}" mode="aspectFill" class="show-image"/>
      <text class="type-text">{{item.type}}</text>
    </view>
  </block>
</view>
<view style="display: flex;">
  <view style="height: 100rpx;" bindtap="turntochatpage">
   <image src="/images/ai.png" style="width: 100rpx; height: 100rpx;"></image>
</view>
<view style="height: 100rpx;" bindtap="turntodishtop">
   <image src="/images/排行榜.png" style="width: 150rpx; height: 100rpx; margin-left:520rpx ;"></image>
</view>
</view>
<view style="font-size: medium; color: gold;">智能ai助手</view>
<view style="height: 80rpx; font-size:larger;color: yellowgreen;text-align: center;margin-bottom: 20rpx;">店长推荐!!!!</view>
<!--商品列表-->
<view class="goods-box">
 <block wx:for="{{onshowList}}">
  <view>
    <image class="goods-image" src="{{item.image}}" data-id="{{item.id}}"bindtap="toContentDetail" ></image>
    <view style="font-weight: 800; font-size:36rpx;color: blueviolet;">{{item.name}}</view>
    <view class="goods-bootom">
    <view style="color: red; ">价值：¥{{item.price}}</view>
   </view>
  </view>
 </block>
</view>

<view style="height: 100rpx;"></view>