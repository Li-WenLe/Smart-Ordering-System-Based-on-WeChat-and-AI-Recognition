.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 10px;
  box-sizing: border-box;
}

.chat-container {
  flex: 1;
  padding: 10px;
  overflow-y: auto;
}

.message {
  margin: 10px 0;
  padding: 10px 15px;
  border-radius: 18px;
  max-width: 80%;
  word-wrap: break-word;
}

.user-message {
  background-color: #95ec69;
  align-self: flex-end;
  margin-left: auto;
}

.ai-message {
  background-color: #f1f1f1;
  align-self: flex-start;
  margin-right: auto;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
}

.loading image {
  width: 30px;
  height: 30px;
  margin-right: 10px;
}

.related-questions {
  margin-top: 15px;
  padding: 10px;
  background-color: #f8f8f8;
  border-radius: 10px;
}

.related-title {
  font-weight: bold;
  display: block;
  margin-bottom: 5px;
}

.question-item {
  padding: 8px;
  margin: 5px 0;
  background-color: #e9e9e9;
  border-radius: 5px;
  color: #333;
}

.camera-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #000;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.take-photo-btn {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background-color: #fff;
  opacity: 0.8;
  font-size:larger;
}

.close-camera-btn {
  position: absolute;
  bottom: 30px;
  right: 20px;
  background-color: rgba(255, 255, 255, 0.3);
  color: white;
}

.preview-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #000;
  z-index: 101;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.preview-image {
  width: 100%;
  height: 70vh;
}

.preview-actions {
  position: absolute;
  bottom: 30px;
  width: 100%;
  display: flex;
  justify-content: space-around;
}

.preview-btn {
  width: 120px;
}

.cancel-btn {
  background-color: #999;
  color: #fff;
}

.confirm-btn {
  background-color: #07C160;
  color: #fff;
}

.input-area {
  display: flex;
  align-items: center;
  padding: 10px;
  background-color: #f8f8f8;
  border-top: 1px solid #eaeaea;
}

.file-btn {
  background: none;
  padding: 0;
  margin: 0 5px;
  line-height: 1;
}

.file-icon {
  height: 20px;
  width: 20px;
}

.camera-btn {
  margin: 0 5px;
  padding: 5px 10px;
  background-color: #f1f1f1;
  border-radius: 5px;
  font-size: 14px;
}

.input {
  flex: 1;
  margin: 0 5px;
  padding: 8px 15px;
  background-color: #fff;
  border-radius: 20px;
  font-size: 14px;
}

.send-btn {
  margin-left: 5px;
  padding: 5px 15px;
  background-color: #07C160;
  color: white;
  border-radius: 5px;
  font-size: 14px;
}